# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Environment variables override the same values from .env.

# Local LLM (Ollama, native API root, no /v1)
OLLAMA_URL=http://127.0.0.1:11434
LLM__LOCAL__MODEL=qwen3.5:9b-q4_K_M
LLM__UNDERSTAND__MODEL=qwen3.5:9b-q4_K_M

# Cloud LLM (any OpenAI-compatible API). Leave the key empty to run local-only.
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=

# Encrypts the API keys of model connections that instructors add (task Z6). Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required once such a key is stored; never commit it.
SETTINGS_ENCRYPTION_KEY=

# First instructor account, created at startup if no instructor exists yet.
# Use setup_local.py to create .env interactively; initial password needs at least 10 characters.
# The password must be changed at first login; you can clear it from .env afterwards.
INSTRUCTOR_USERNAME=
INSTRUCTOR_INITIAL_PASSWORD=

# PostgreSQL (docs/DATABASE.md). Keep the password out of the URL: it goes in PGPASSWORD / POSTGRES_PASSWORD.
# Running the backend on this machine with `docker compose up -d db`:
DATABASE_URL=postgresql+psycopg://tutor@127.0.0.1:5432/tutor
PGPASSWORD=
# Password of the db service in Docker Compose (required by docker-compose.yml); use the same value as above.
POSTGRES_PASSWORD=
# Tests and evaluation harnesses: a server where they may create and drop temporary databases.
TEST_DATABASE_URL=postgresql+psycopg://tutor@127.0.0.1:5432/tutor

# Optional: path to another config file (default: config.yaml in the repository root)
# APP_CONFIG=

# Privacy filter (Beta): let the local model double-check cloud-bound health questions (recommended where
# Ollama runs); see config.yaml privacy.llm_check
# PRIVACY__LLM_CHECK=true

# --- Docker Compose only ------------------------------------------------------------
# spaCy model baked into the API image (the privacy filter is configured to match it)
# SPACY_MODEL=en_core_web_lg
# Port of the web container on this machine (default 8080)
# WEB_PORT=8080

# --- Overrides of config.yaml: SECTION__FIELD=value ------------------------------------
# CONTENT__SEED_STATUS=active         # demo only: import the unreviewed demo content as published
#                                     # (applies when the demo course is first created)
# PRIVACY__SPACY_MODEL=en_core_web_sm # local development without Docker (with Docker use SPACY_MODEL)
# ROUTING__STUB_SCORE=1.0             # demo: send cloud-safe questions to the cloud route
# AUTH__COOKIE_SECURE=true            # behind HTTPS
