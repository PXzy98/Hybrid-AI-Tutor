# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Environment variables override the same values from .env.

# Local LLM: the deployment's own vLLM (OpenAI-compatible API root, ending in /v1), trusted local: it receives
# the original question text. VLLM_KEY is the server's --api-key (empty if it has none). The model is the name
# the server lists under /models (vLLM --served-model-name); config.yaml defaults to Qwen3.5-9B.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_KEY=
# LLM__LOCAL__MODEL=Qwen3.5-9B
# LLM__UNDERSTAND__MODEL=Qwen3.5-9B

# Cloud LLM (any OpenAI-compatible API). Leave the key empty to run local-only.
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=

# Web search for cloud answers that need recent information (task T13; docs/WEB_SEARCH.md):
# openai (default: OpenAI web search, needs OPENAI_API_KEY) | api (Tavily-format search API, needs
# TAVILY_API_KEY) | searxng (Compose profile searxng, no key) | off. Only the chosen provider's key is read;
# without it the search step fails and answers use the course material only.
WEBSEARCH__PROVIDER=openai
OPENAI_API_KEY=
TAVILY_API_KEY=
# required when the searxng profile runs: a long random string
SEARXNG_SECRET=

# Encrypts the API keys of model connections that instructors add (task Z6). Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required once such a key is stored; never commit it.
SETTINGS_ENCRYPTION_KEY=

# First instructor account, created at startup if no instructor exists yet.
# Use setup_local.py to create .env interactively; initial password needs at least 10 characters.
# The password must be changed at first login; you can clear it from .env afterwards.
INSTRUCTOR_USERNAME=
INSTRUCTOR_INITIAL_PASSWORD=

# PostgreSQL (docs/DATABASE.md). Keep the password out of the URL: it goes in PGPASSWORD / POSTGRES_PASSWORD.
# Running the backend on this machine with `docker compose up -d db`:
DATABASE_URL=postgresql+psycopg://tutor@127.0.0.1:5432/tutor
PGPASSWORD=
# Password of the db service in Docker Compose (required by docker-compose.yml); use the same value as above.
POSTGRES_PASSWORD=
# Tests and evaluation harnesses: a server where they may create and drop temporary databases.
TEST_DATABASE_URL=postgresql+psycopg://tutor@127.0.0.1:5432/tutor

# Optional: path to another config file (default: config.yaml in the repository root)
# APP_CONFIG=

# Privacy filter: the local model double-checks cloud-bound questions that may reveal health (on by default
# since Z22d; fails closed, so turn it off only where no local model runs); see config.yaml privacy.llm_check
# PRIVACY__LLM_CHECK=false

# --- Docker Compose only ------------------------------------------------------------
# spaCy model baked into the API image (the privacy filter is configured to match it)
# SPACY_MODEL=en_core_web_lg
# Proxy (Caddy, task Z8). Local: plain HTTP on HTTP_PORT. Production: your domain name and the standard ports;
# Caddy then obtains the HTTPS certificate itself.
# SITE_ADDRESS=tutor.example.edu
# HTTP_PORT=80
# HTTPS_PORT=443
# Monitoring (docker compose --profile monitoring): Grafana's admin password, required; its port on 127.0.0.1
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000

# --- Overrides of config.yaml: SECTION__FIELD=value ------------------------------------
# CONTENT__SEED_STATUS=active         # demo only: import the unreviewed demo content as published
#                                     # (applies when the demo course is first created)
# PRIVACY__SPACY_MODEL=en_core_web_sm # local development without Docker (with Docker use SPACY_MODEL)
# ROUTING__STUB_SCORE=1.0             # demo: send cloud-safe questions to the cloud route
# AUTH__COOKIE_SECURE=true            # behind HTTPS (docker-compose.prod.yml sets it)
