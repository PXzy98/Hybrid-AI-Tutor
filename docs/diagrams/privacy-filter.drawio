<mxfile host="app.diagrams.net" type="device"><diagram id="privacy-filter" name="privacy-filter"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q" value="&lt;b&gt;Student question (raw text)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;POST /api/v1/ask · student_id from the login session&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3edf9;strokeColor=#2b6cc4;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="300" height="80" as="geometry"/></mxCell><mxCell id="id" value="&lt;b&gt;Load identity terms&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;display name, its parts (≥ 3 letters), username · read from `account`, kept in memory only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#1f9e6e;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="300" height="90" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;1 · Detect (all recognizers run on the same text)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;spaCy NER (en_core_web_lg) → PERSON&lt;br&gt;Presidio patterns → EMAIL_ADDRESS, PHONE_NUMBER&lt;br&gt;custom: STUDENT_ID (9 digits; spaced only with context words) · GRADE (“I got 58/100”, “my GPA…”)&lt;br&gt;custom: PHONE (North American, separators required) · Chinese self-introduction names&lt;br&gt;custom: HEALTH_DETAIL — condition / symptom / medicine / reading of the student or someone they know&lt;br&gt;custom: POSTAL_CODE · HEALTH_CARD · ID_NUMBER (SIN, MRN) · DATE_OF_BIRTH · ADDRESS · French phrasing&lt;br&gt;identity terms → PERSON / USERNAME (whole words, always)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#1f9e6e;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="600" height="230" as="geometry"/></mxCell><mxCell id="clean" value="&lt;b&gt;2 · Clean up&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;drop scores &amp;lt; 0.5 · person fixes: cut digits, drop acronyms, drop eponyms (Cohen&amp;#x27;s kappa)&lt;br&gt;allow-list: course staff (Dr. Abbas) · overlaps: a PERSON span never hides a health detail;&lt;br&gt;otherwise keep the longer span, then the higher score&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#1f9e6e;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="600" height="130" as="geometry"/></mxCell><mxCell id="anon" value="&lt;b&gt;3 · Anonymize&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;replace each finding by a numbered placeholder &amp;lt;PERSON_1&amp;gt;, &amp;lt;STUDENT_ID_1&amp;gt;, …&lt;br&gt;placeholder → value mapping: private attribute of the request, memory only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#1f9e6e;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="500" width="600" height="100" as="geometry"/></mxCell><mxCell id="dec" value="&lt;b&gt;4 · Local-only type present?&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;HEALTH_DETAIL found → cloud_safe = false&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff6d8;strokeColor=#c9930a;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="360" height="90" as="geometry"/></mxCell><mxCell id="err" value="&lt;b&gt;Filter unavailable / error&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;missing spaCy model or exception → request stops (HTTP 503) · never skipped&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#d64545;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="320" height="110" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;Stored and logged&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;sanitized text only: request_log, session history, admin logs · never the raw question&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f1ef;strokeColor=#6b6b6b;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="320" height="120" as="geometry"/></mxCell><mxCell id="route" value="&lt;b&gt;Route (Tongkai)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;score vs threshold · cloud_safe = false forces local&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6472;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="280" height="90" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;Local model (inside the boundary)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;may see the raw question and the full learner context&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdebe1;strokeColor=#e06a2c;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="320" height="110" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;5 · Pre-send leak guard&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;re-scan the sanitized question for PII · student_id, item IDs, misconception text → block&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#1f9e6e;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="780" width="310" height="110" as="geometry"/></mxCell><mxCell id="cloud" value="&lt;b&gt;Cloud LLM (outside)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;CloudRequest only: sanitized question, topic, passages, 3 coarse labels&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#d64545;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="780" width="300" height="120" as="geometry"/></mxCell><mxCell id="restore" value="&lt;b&gt;6 · Restore + verify&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;placeholders → original values in the answer · pii_leak / profile_leak checkers · mapping cleared&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#1f9e6e;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="950" width="600" height="90" as="geometry"/></mxCell><mxCell id="ans" value="&lt;b&gt;Answer to the student&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#475569&#x27;&gt;with sources and a check question&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3edf9;strokeColor=#2b6cc4;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="955" width="300" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="q" target="id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="raw text" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="q" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="terms" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="id" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="findings" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="det" target="clean"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="clean" target="anon"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="anon" target="dec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="error" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="det" target="err"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="sanitized text" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="anon" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="cloud_safe flag" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="dec" target="route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="local" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="route" target="local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="cloud" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="route" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="pass" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="guard" target="cloud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="answer" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="local" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="answer" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="cloud" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="endArrow=block;html=1;strokeColor=#5b6472;fontSize=10;" edge="1" parent="1" source="restore" target="ans"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>