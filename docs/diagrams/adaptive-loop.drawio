<mxfile host="app.diagrams.net" type="device"><diagram id="adaptive-loop" name="adaptive-loop"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="730" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Cold start&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;consent&lt;br&gt;2–3 preference questions&lt;br&gt;5–10 diagnostic MCQs&lt;br&gt;→ initial learner state&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 · Student asks or answers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;a question in a topic, or&lt;br&gt;the answer to a check question&lt;br&gt;(PII removed first)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="300" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2 · Extract evidence&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;strong: check MCQ graded by code&lt;br&gt;weak: local LLM → KC, question type,&lt;br&gt;confusion, misconception ID&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="300" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3 · Update learner state&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;BKT per KC (rule fallback)&lt;br&gt;weak evidence = noisy observation&lt;br&gt;misconception status · preference signals&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="320" height="140" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4 · Adapt teaching&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;level per KC: basic / intermediate / advanced&lt;br&gt;retrieve chunks by KC + level&lt;br&gt;address a known misconception&lt;br&gt;presentation from preferences&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#5f6b7a;fillColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="320" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5 · Answer + check question&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;explanation at the chosen level&lt;br&gt;one check MCQ on the main KC&lt;br&gt;suggest the next KC&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#5f6b7a;fillColor=#ffffff;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="740" y="360" width="300" height="150" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Level bands (per KC, from P(mastery))&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;&amp;lt; 0.40  →  basic&lt;br&gt;0.40 – 0.70  →  intermediate&lt;br&gt;&amp;gt; 0.70  →  advanced&lt;br&gt;±0.05 hysteresis so the level does not flip each turn&lt;br&gt;question touches several KCs → the lowest one decides&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#9aa3ad;fillColor=#f7f8fa;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="440" height="128" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Privacy inside the loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;learner state is read and written only locally&lt;br&gt;local model: full LearnerContext&lt;br&gt;cloud: sanitized question + level + style labels&lt;br&gt;misconception fixes added locally after a cloud answer&lt;br&gt;evidence log keeps IDs and scores, never raw text&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#9aa3ad;fillColor=#f7f8fa;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="570" width="440" height="128" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Evaluation gate (after MVP)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;simulated students with a hidden true mastery&lt;br&gt;simulator ≠ BKT (forgetting, other slip / guess)&lt;br&gt;compare BKT vs rule: MAE and next-answer AUC&lt;br&gt;BKT not clearly better → switch to rule (config only)&lt;br&gt;personalization on / off: personas, blind rating&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#9aa3ad;fillColor=#f7f8fa;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="440" height="128" as="geometry"/></mxCell><mxCell id="c9" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5357;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="435"/></Array></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;Continuous adaptive loop · every interaction updates the learner state&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#555555'&gt;Ask or answer → extract evidence → update state → adapt teaching → answer + check question → update again&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c12" value="evidence" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1044" y="170" width="72" height="14" as="geometry"/></mxCell><mxCell id="c14" value="LearnerContext" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1286" y="302" width="110" height="16" as="geometry"/></mxCell><mxCell id="c16" value="prompt" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1046" y="415" width="70" height="14" as="geometry"/></mxCell><mxCell id="c18" value="student answers the check" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="440" width="180" height="16" as="geometry"/></mxCell><mxCell id="c19" value="&lt;i&gt;continuous loop · strong evidence moves mastery most;&lt;br&gt;weak evidence only nudges it&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="380" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
