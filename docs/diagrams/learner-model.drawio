<mxfile host="app.diagrams.net" type="device"><diagram id="learner-model" name="learner-model"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;font color='#b83332'&gt;Privacy boundary · application server + GPU server (local network)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#e34948;dashed=1;dashPattern=6 4;verticalAlign=bottom;align=right;spacingLeft=12;spacingRight=10;spacingTop=4;spacingBottom=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1090" height="716" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font color='#0f8a5f'&gt;LearnerModel facade · each model can be replaced on its own&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#f4fbf8;strokeColor=#1baf7a;dashed=1;dashPattern=6 4;verticalAlign=bottom;align=right;spacingLeft=12;spacingRight=10;spacingTop=4;spacingBottom=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="460" height="480" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Presentation feedback&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;“more detail”, “show me an example”&lt;br&gt;→ Preference Model only&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="146" width="280" height="88" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cold start (onboarding)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;consent + 2–3 preference questions&lt;br&gt;5–10 diagnostic MCQs&lt;br&gt;→ initial preferences and mastery&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="280" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Check question answers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;STRONG evidence&lt;br&gt;graded by code against the MCQ key&lt;br&gt;→ BKT update (slip / guess)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="280" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Question understanding&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;WEAK evidence · local LLM, JSON only&lt;br&gt;KC IDs, question type,&lt;br&gt;confusion, misconception catalog ID&lt;br&gt;→ noisy observation (≈2× likelihood)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="488" width="280" height="122" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Preference Model (auxiliary) · how to present&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;interface PreferenceModel: get() · update()&lt;br&gt;sequencing: example-first | concept-first&lt;br&gt;detail: concise | detailed&lt;br&gt;never changes the level, the KC or the content&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="420" height="116" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Knowledge Model (core) · what to teach, how deep&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;interface KnowledgeModel: state() · update()&lt;br&gt;default: BKT per KC&lt;br&gt;    p_init, p_learn, p_slip, p_guess (per difficulty)&lt;br&gt;fallback: rule — accuracy of the last N strong answers&lt;br&gt;state per KC: P(mastery), n_obs, last_seen&lt;br&gt;misconceptions: catalog ID → suspected / confirmed / resolved&lt;br&gt;level per KC: &amp;lt; 0.4 basic · 0.4–0.7 intermediate · &amp;gt; 0.7 advanced&lt;br&gt;(±0.05 hysteresis)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="294" width="420" height="214" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Recommender&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;next KC = all prerequisites ≥ 0.7, own mastery &amp;lt; 0.9,&lt;br&gt;lowest P(mastery) first; current topic breaks ties&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="522" width="420" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;LearnerContext&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;local model prompt only&lt;br&gt;level per KC&lt;br&gt;misconception + reviewed fix&lt;br&gt;preferences · next KC&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="146" width="210" height="146" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Retrieval filter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;KC IDs + level → RAG&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#c23a6e'&gt;&lt;b&gt;Siyun's step&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#d55181;fillColor=#fbe9f0;strokeWidth=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="890" y="310" width="210" height="74" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Instructor summary&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;mastery per KC, aggregated&lt;br&gt;groups of n ≥ 5 only&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2a78d6;fillColor=#e3eefb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="402" width="210" height="88" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;CloudLabels (allow-list)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;level: basic | intermediate |&lt;br&gt;advanced&lt;br&gt;sequencing · detail&lt;br&gt;no ID, no history,&lt;br&gt;no misconceptions&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#1baf7a;fillColor=#e2f5ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="508" width="210" height="126" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Cloud LLM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;receives: sanitized question,&lt;br&gt;course passages, CloudLabels&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#e34948;fillColor=#fbe7e7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="526" width="210" height="90" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Domain content (reviewed)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;KC map: 20–30 KCs + prerequisites&lt;br&gt;item bank: 3–5 MCQs per KC&lt;br&gt;misconception catalog + corrections&lt;br&gt;RAG chunks tagged KC + level&lt;br&gt;LLM draft → team check → Dr. Abbas&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#c98a00;fillColor=#fdf3d6;strokeWidth=2;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="280" height="130" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;SQLite (local)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;learner_kc_state · learner_misconception · preferences&lt;br&gt;evidence_log: KC, item, score, weight, time (no raw text)&lt;br&gt;student can view, reset or delete their profile&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#5f6b7a;fillColor=#f1f1ef;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="460" height="130" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Swap points (config.yaml)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px' color='#555555'&gt;learner.knowledge: bkt | rule&lt;br&gt;learner.preference: simple | ils&lt;br&gt;learner.weak_evidence: on | off&lt;br&gt;learner.levels: 0.4 / 0.7&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#9aa3ad;fillColor=#f7f8fa;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="890" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="c13" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.2586;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.24;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.7759;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="366" y="276"/><mxPoint x="366" y="250"/></Array></mxGeometry></mxCell><mxCell id="c15" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.68;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.1215;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5888;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;exitX=1.0;exitY=0.0984;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.9626;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="c21"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="219" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c26" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="c22"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="347" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c27" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="c23"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="446" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c28" style="html=1;rounded=1;strokeColor=#5f6b7a;strokeWidth=1.2;endArrow=block;endFill=1;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="c24"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="571" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c30" style="html=1;rounded=1;strokeColor=#e34948;strokeWidth=1.4;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c24" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" style="html=1;rounded=1;strokeColor=#8a8a8a;strokeWidth=1.0;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;dashPattern=5 3;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="c32"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="610" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;Learner Model · two independent models behind one interface&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#555555'&gt;Knowledge Model decides what to teach and how deep · Preference Model only decides how to present · all state stays local&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="44" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;EVIDENCE IN&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="116" width="280" height="20" as="geometry"/></mxCell><mxCell id="c18" value="strong" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#0f8a5f;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="344" y="404" width="52" height="14" as="geometry"/></mxCell><mxCell id="c19" value="weak" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#777777;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="344" y="484" width="52" height="14" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;CONTEXT OUT&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="890" y="116" width="210" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
